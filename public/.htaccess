# Send every request that does not point to an existing file or directory
# to index.php. Requires mod_rewrite (enabled by default in WAMP).
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

# Protect against directory listing
Options -Indexes
